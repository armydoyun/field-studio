{
  "name": "field-studio",
  "private": true,
  "description": "WebGL2 셰이더 스튜디오 — 빌드·테스트 도구 정의(앱 자체는 의존성 없음)",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tests/run.mjs",
    "test:node": "node tests/run.mjs node",
    "test:browser": "node tests/run.mjs browser",
    "test:py": "node tests/run.mjs py",
    "test:list": "node tests/run.mjs --list",
    "test:ci": "node tests/run.mjs --strict",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write js tools",
    "format:check": "prettier --check js tools"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "esbuild": "0.24.2",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "playwright": "1.48.2",
    "prettier": "3.3.3"
  }
}
